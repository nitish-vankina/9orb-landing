# URL of the 9orb Protect application (the authenticated product).
# The marketing site never hosts the app itself — every "Launch Protect"
# and "Sign In" action links out to this URL.
#
# Local development default:
NEXT_PUBLIC_PROTECT_APP_URL=http://localhost:3001

# Production example:
# NEXT_PUBLIC_PROTECT_APP_URL=https://app.9orb.com

# Canonical marketing site URL, used for metadata, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://9orb.com
